# Copy to .env and fill in the blank values. .env is ignored by Git and by
# Docker builds; never commit real credentials.

# Lets plain `docker compose` commands use the local development stack.
# COMPOSE_FILE=docker-compose-dev.yml

# Django settings
# Required and unique per environment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Local development only. Production must keep DEBUG=False, the default.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Behind your own HTTPS reverse proxy or tunnel only: trust X-Forwarded-Proto.
# TRUST_X_FORWARDED_PROTO=False
# Public origins allowed to submit forms, comma-separated.
# CSRF_TRUSTED_ORIGINS=https://library.example.com

# Database settings
# Set either DATABASE_URL (it takes precedence) or the DB_* values below.
# Percent-encode special characters in the URL password.
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/library_db
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=library_db
DB_USER=postgres
# Required. Docker Compose also creates its PostgreSQL volume with it.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Embedding model cache for a local venv (python scripts/fetch_embedding_model.py
# writes here). Docker images ship with the model in /app/.cache/book-embeddings.
# BOOK_EMBEDDING_CACHE_DIR=/path/to/book-embeddings-cache

# Embedding model setting: build-time; leave empty for the defaults in
# library/book/embedding_config.py. Changing it means rebuilding the image
# (docker build --build-arg ...) or re-running the fetch script.
# BOOK_EMBEDDING_MODEL=
# BOOK_EMBEDDING_MODEL_REVISION=
# BOOK_EMBEDDING_MODEL_FILE=
# BOOK_EMBEDDING_TOKENIZER_FILE=
# BOOK_EMBEDDING_DIMENSIONS=
# BOOK_EMBEDDING_POOLING=
# BOOK_EMBEDDING_QUERY_PREFIX=
# BOOK_EMBEDDING_DOCUMENT_PREFIX=
# BOOK_EMBEDDING_MAX_TOKENS=
# Runtime tuning: inference threads per model copy.
BOOK_EMBEDDING_THREADS=2
# Event queue (Docker Compose overrides the host with redis)
CELERY_BROKER_URL=redis://localhost:6379/0

# Database backups (the Compose backup service; not secrets).
# UTC hour at or after which each day's backup runs (1 is 03:00 or 04:00 in Kyiv).
# BACKUP_HOUR=1
# Days backups are kept; the 7 newest always stay.
# BACKUP_KEEP_DAYS=7
