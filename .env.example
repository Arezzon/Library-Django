# Copy to .env and fill in the blank values. .env is ignored by Git and by
# Docker builds; never commit real credentials.

# Django settings
# Required and unique per environment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Local development only. Production must keep DEBUG=False, the default.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database settings
# Set either DATABASE_URL (it takes precedence) or the DB_* values below.
# Percent-encode special characters in the URL password.
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/library_db
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=library_db
DB_USER=postgres
# Required. Docker Compose also creates its PostgreSQL volume with it.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional local model cache (Docker uses a persistent named volume).
# BOOK_EMBEDDING_CACHE_DIR=/path/to/book-embeddings-cache
# Event queue (Docker Compose overrides the host with redis)
CELERY_BROKER_URL=redis://localhost:6379/0
